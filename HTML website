<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Quanta — Learn Quantum Mechanics</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:        #03050F;
    --bg2:       #060A1E;
    --glass:     rgba(16, 23, 54, 0.55);
    --glass-2:   rgba(22, 31, 68, 0.65);
    --border:    rgba(91, 140, 255, 0.18);
    --border-hi: rgba(91, 140, 255, 0.5);
    --text:      #EAF0FF;
    --text-soft: #7C88B8;

    --blue:      #3B82F6;
    --blue-glow: rgba(59,130,246,.45);
    --cyan:      #22D3EE;
    --cyan-glow: rgba(34,211,238,.4);
    --gold:      #FFC845;
    --flame:     #FF7A45;

    --font-display: "Space Grotesk", sans-serif;
    --font-body: "Inter", sans-serif;
    --font-mono: "JetBrains Mono", monospace;
    --radius: 16px;
  }

  body.light-mode{
    --bg:        #F3F6FF;
    --bg2:       #E9EEFC;
    --glass:     rgba(255, 255, 255, 0.7);
    --glass-2:   rgba(255, 255, 255, 0.9);
    --border:    rgba(59, 130, 246, 0.2);
    --border-hi: rgba(59, 130, 246, 0.45);
    --text:      #0B1020;
    --text-soft: #5B638A;
  }

  *{ box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    background:
      radial-gradient(ellipse 60% 40% at 15% 0%, rgba(59,130,246,.16), transparent 60%),
      radial-gradient(ellipse 50% 35% at 90% 15%, rgba(34,211,238,.10), transparent 60%),
      radial-gradient(ellipse 70% 50% at 50% 100%, rgba(59,130,246,.08), transparent 60%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg2) 100%);
    color: var(--text);
    font-family: var(--font-body);
    min-height: 100vh;
    position: relative;
    overflow-x:hidden;
    transition: background .3s ease, color .3s ease;
  }

  #fx{ position: fixed; inset:0; z-index:0; pointer-events:none; }

  .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 28px; position:relative; z-index:1; }
  h1,h2,h3{ font-family: var(--font-display); margin:0; letter-spacing: -0.01em; }
  a{ color: inherit; }
  button{ font-family: var(--font-body); cursor:pointer; }

  /* ---------- top bar ---------- */
  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    padding: 22px 0;
  }
  .brand{ display:flex; align-items:center; gap:12px; }
  .atom{ width:38px; height:38px; position:relative; filter: drop-shadow(0 0 8px var(--blue-glow)); }
  .atom svg{ width:100%; height:100%; }
  .atom .orbit{ transform-origin: 17px 17px; animation: spin 6s linear infinite; }
  .atom .orbit.o2{ animation-duration: 9s; animation-direction: reverse; }
  @keyframes spin{ to{ transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce){ .atom .orbit{ animation: none; } }
  .brand-name{
    font-family: var(--font-display); font-weight:700; font-size: 21px;
    background: linear-gradient(90deg, #fff, var(--cyan));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .brand-tag{ font-family: var(--font-mono); font-size: 11px; color: var(--text-soft); display:block; margin-top:-2px; }

  .top-right{ display:flex; align-items:center; gap:14px; }
  .chip{
    display:flex; align-items:center; gap:7px;
    background: var(--glass); border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    padding: 8px 14px; border-radius: 999px;
    font-family: var(--font-mono); font-size: 13px;
  }
  .chip.credits{ color: var(--gold); box-shadow: 0 0 16px rgba(255,200,69,.08) inset; }
  .chip.streak{ color: var(--flame); box-shadow: 0 0 16px rgba(255,122,69,.08) inset; }
  .chip svg{ width:16px; height:16px; }

  .profile-btn{
    width: 42px; height:42px; border-radius:50%;
    background: linear-gradient(135deg, var(--blue), var(--cyan));
    background-size: cover; background-position:center;
    border: none; color:#03050F; font-family: var(--font-display); font-weight:700;
    font-size: 14px; display:flex; align-items:center; justify-content:center;
    box-shadow: 0 0 0 3px rgba(59,130,246,.12), 0 0 18px var(--blue-glow);
  }

  /* ---------- hero ---------- */
  .hero{ padding: 40px 0 50px; text-align:left; }
  .eyebrow{
    font-family: var(--font-mono); font-size: 12px; letter-spacing:.08em; text-transform: uppercase;
    color: var(--cyan);
  }
  .hero h1{
    font-size: clamp(32px, 4.6vw, 50px); margin-top: 12px; max-width: 17ch; line-height: 1.08;
    background: linear-gradient(100deg, #fff 20%, var(--cyan) 55%, var(--blue) 90%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  body.light-mode .hero h1{
    background: linear-gradient(100deg, #0B1020 20%, var(--blue) 70%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero p{ color: var(--text-soft); max-width: 56ch; margin-top: 16px; font-size: 15.5px; }

  /* ---------- bento grid ---------- */
  .bento{
    display:grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 18px;
    padding-bottom: 60px;
  }
  @media (max-width: 900px){ .bento{ grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px){ .bento{ grid-template-columns: 1fr; } }

  .box{
    background: var(--glass);
    border: 1px solid var(--border);
    backdrop-filter: blur(14px);
    border-radius: var(--radius);
    padding: 22px;
    text-align: left;
    color: var(--text);
    display:flex; flex-direction:column; justify-content:space-between;
    min-height: 150px;
    position: relative;
    overflow: hidden;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }
  .box::before{
    content:""; position:absolute; inset:0; opacity:0;
    background: radial-gradient(240px circle at var(--mx,50%) var(--my,0%), rgba(91,140,255,.15), transparent 60%);
    transition: opacity .25s ease;
    pointer-events:none;
  }
  .box:hover{
    transform: translateY(-4px);
    border-color: var(--border-hi);
    background: var(--glass-2);
    box-shadow: 0 10px 40px -12px var(--box-accent, var(--blue-glow));
  }
  .box:hover::before{ opacity:1; }
  .box:focus-visible{ outline: 2px solid var(--cyan); outline-offset: 2px; }

  .box--tutor{ grid-row: span 2; --box-accent: var(--blue-glow); background: linear-gradient(160deg, var(--glass-2), var(--glass)); }
  .box-icon{
    width: 42px; height:42px; border-radius: 11px;
    background: var(--icon-bg, rgba(59,130,246,.14)); color: var(--icon-color, var(--blue));
    display:flex; align-items:center; justify-content:center;
    margin-bottom: 16px;
    box-shadow: 0 0 20px -6px var(--icon-color, var(--blue));
  }
  .box-icon svg{ width:22px; height:22px; }
  .box h3{ font-size: 18px; }
  .box .desc{ font-size: 13.5px; color: var(--text-soft); margin-top: 6px; line-height: 1.5; }
  .box .foot{ display:flex; align-items:center; justify-content:space-between; margin-top: 18px; position:relative; z-index:1; }
  .box .badge{
    font-family: var(--font-mono); font-size: 11px; color: var(--text-soft);
    border: 1px solid var(--border); padding: 4px 9px; border-radius: 999px;
  }
  .box .arrow{ font-size: 18px; color: var(--icon-color, var(--blue)); }

  .box--tutor .desc{ max-width: 34ch; }
  .box--tutor .mini-log{ margin-top: 18px; display:flex; flex-direction:column; gap:8px; position:relative; z-index:1; }
  .mini-msg{ font-size: 12.5px; padding: 8px 10px; border-radius: 8px; max-width: 85%; }
  .mini-msg.s{ align-self:flex-end; background: rgba(34,211,238,.12); color: var(--cyan); }
  .mini-msg.t{ align-self:flex-start; background: rgba(255,255,255,.05); color: var(--text-soft); }

  /* ---------- modal ---------- */
  .overlay{
    position: fixed; inset:0; background: rgba(2,4,12,.78);
    backdrop-filter: blur(4px);
    display:none; align-items:center; justify-content:center;
    padding: 24px; z-index: 50;
  }
  .overlay.open{ display:flex; }
  .modal{
    background: rgba(9,13,32,.92); border: 1px solid var(--border); border-radius: 18px;
    width: 100%; max-width: 560px; max-height: 82vh; overflow-y:auto;
    padding: 26px;
    box-shadow: 0 0 60px -10px rgba(59,130,246,.25);
  }
  body.light-mode .modal{ background: rgba(255,255,255,.96); }
  .modal-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom: 18px; }
  .modal-head h2{ font-size: 21px; }
  .close-btn{
    background: var(--glass); border: 1px solid var(--border); color: var(--text);
    width: 32px; height:32px; border-radius: 8px; display:flex; align-items:center; justify-content:center;
  }

  /* list items (quiz/summary/lecture) */
  .item-row{
    display:flex; align-items:center; justify-content:space-between; gap: 12px;
    padding: 13px 0; border-bottom: 1px solid var(--border);
  }
  .item-row:last-child{ border-bottom: none; }
  .item-info h4{ font-family: var(--font-body); font-weight:600; font-size: 14.5px; margin:0; }
  .item-info .tags{ display:flex; gap:8px; margin-top: 6px; }
  .difficulty{
    font-family: var(--font-mono); font-size: 10.5px; text-transform:uppercase;
    padding: 2px 8px; border-radius: 5px;
  }
  .difficulty.easy{ background: rgba(34,211,238,.14); color: var(--cyan); }
  .difficulty.medium{ background: rgba(59,130,246,.16); color: #8FB4FF; }
  .difficulty.hard{ background: rgba(255,122,69,.14); color: var(--flame); }
  .credit-tag{ font-family: var(--font-mono); font-size: 10.5px; color: var(--text-soft); }

  .action-btn{
    background: var(--blue); color: #fff; border:none; border-radius: 8px;
    padding: 8px 14px; font-size: 12.5px; font-weight:600; white-space:nowrap;
    box-shadow: 0 0 16px -4px var(--blue-glow);
  }
  .action-btn.done{ background: rgba(34,211,238,.14); color: var(--cyan); box-shadow:none; }
  .action-btn:disabled{ cursor: default; }

  /* track record */
  .stat-grid{ display:grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 20px; }
  .stat-box{ background: var(--glass); border:1px solid var(--border); border-radius: 12px; padding: 14px; text-align:center; }
  .stat-box b{ display:block; font-family: var(--font-mono); font-size: 20px; color: var(--gold); }
  .stat-box.streak b{ color: var(--flame); }
  .stat-box span{ font-size: 11px; color: var(--text-soft); }

  .topic-bar{ margin-bottom: 14px; }
  .topic-bar .tb-head{ display:flex; justify-content:space-between; font-size: 13px; margin-bottom:6px; }
  .topic-bar .tb-head span:last-child{ color: var(--text-soft); font-family: var(--font-mono); font-size: 11.5px; }
  .tb-track{ height: 7px; border-radius: 4px; background: rgba(255,255,255,.06); overflow:hidden; }
  .tb-fill{ height:100%; background: linear-gradient(90deg, var(--blue), var(--cyan)); box-shadow: 0 0 10px var(--blue-glow); }

  /* tutor modal chat */
  .chat-log{ display:flex; flex-direction:column; gap:10px; max-height: 320px; overflow-y:auto; padding-right:4px; margin-bottom: 14px; }
  .chat-msg{ padding: 10px 13px; border-radius: 10px; font-size: 14px; max-width: 85%; }
  .chat-msg.student{ align-self:flex-end; background: rgba(34,211,238,.12); color: var(--cyan); }
  .chat-msg.tutor{ align-self:flex-start; background: var(--glass); border: 1px solid var(--border); color: var(--text); }
  .chat-input-row{ display:flex; gap: 8px; }
  .chat-input-row input{
    flex:1; background: var(--glass); border: 1px solid var(--border); border-radius: 8px;
    padding: 11px 13px; color: var(--text); font-family: var(--font-body); font-size: 14px;
  }
  .chat-input-row input:focus{ outline: 2px solid var(--blue); }
  .chat-input-row button{
    background: var(--blue); color:#fff; border:none; border-radius:8px; padding: 0 18px; font-weight:600;
    box-shadow: 0 0 16px -4px var(--blue-glow);
  }

  /* ---------- profile modal ---------- */
  .profile-view{ display:none; }
  .profile-view.active{ display:block; }

  /* menu view */
  .profile-hero{ display:flex; flex-direction:column; align-items:center; text-align:center; margin-bottom: 22px; }
  .avatar-edit{
    position: relative; width: 76px; height:76px; border-radius:50%; cursor:pointer;
    margin-bottom: 14px;
  }
  .profile-avatar{
    width: 76px; height:76px; border-radius:50%;
    background: linear-gradient(135deg, var(--blue), var(--cyan));
    background-size: cover; background-position:center;
    display:flex; align-items:center; justify-content:center;
    font-family: var(--font-display); font-weight:700; font-size: 24px; color: #03050F;
    box-shadow: 0 0 24px -4px var(--blue-glow);
  }
  .avatar-edit .pencil{
    position:absolute; bottom:-2px; right:-2px;
    width: 26px; height:26px; border-radius:50%;
    background: var(--blue); border: 2px solid rgba(9,13,32,.92);
    display:flex; align-items:center; justify-content:center;
    color:#fff;
  }
  .avatar-edit .pencil svg{ width:13px; height:13px; }
  .avatar-edit input[type="file"]{ display:none; }

  .profile-name{ font-size: 18px; font-weight:600; }
  .profile-role{ font-size: 12.5px; color: var(--text-soft); font-family: var(--font-mono); margin-top: 4px; }

  .profile-menu{ display:flex; flex-direction:column; gap: 6px; }
  .menu-item{
    display:flex; align-items:center; gap: 12px;
    background: transparent; border: 1px solid transparent; border-radius: 10px;
    padding: 12px 12px; text-align:left; color: var(--text); font-size: 14.5px; font-weight:500;
    transition: background .15s ease, border-color .15s ease;
  }
  .menu-item:hover{ background: var(--glass); border-color: var(--border); }
  .menu-item .m-icon{
    width: 34px; height:34px; border-radius: 9px; flex-shrink:0;
    background: rgba(59,130,246,.14); color: var(--blue);
    display:flex; align-items:center; justify-content:center;
  }
  .menu-item .m-icon svg{ width:17px; height:17px; }
  .menu-item .m-label{ flex:1; }
  .menu-item .m-chevron{ color: var(--text-soft); font-size: 15px; }

  .toggle{
    width: 40px; height: 22px; border-radius: 999px; background: rgba(255,255,255,.12);
    position: relative; flex-shrink:0; border: 1px solid var(--border);
    transition: background .2s ease;
  }
  .toggle::after{
    content:""; position:absolute; top:2px; left:2px; width:16px; height:16px; border-radius:50%;
    background: #fff; transition: transform .2s ease;
  }
  .toggle.on{ background: var(--blue); }
  .toggle.on::after{ transform: translateX(18px); }

  /* edit / links view */
  .back-row{ display:flex; align-items:center; gap:10px; margin-bottom: 4px; }
  .back-btn{
    background: var(--glass); border: 1px solid var(--border); color: var(--text);
    width: 30px; height:30px; border-radius: 8px; display:flex; align-items:center; justify-content:center;
  }
  .section-label{
    font-family: var(--font-mono); font-size: 11px; text-transform:uppercase; letter-spacing:.05em;
    color: var(--text-soft); margin: 20px 0 10px;
  }
  .field{ margin-bottom: 14px; }
  .field label{ display:block; font-size: 11.5px; color: var(--text-soft); font-family: var(--font-mono); margin-bottom:6px; text-transform:uppercase; letter-spacing:.04em; }
  .field input{
    width:100%; background: var(--glass); border: 1px solid var(--border); border-radius: 8px;
    padding: 10px 12px; color: var(--text); font-family: var(--font-body); font-size: 14px;
  }
  .field input:focus{ outline: 2px solid var(--blue); }

  .link-row{ display:flex; align-items:center; gap: 14px; flex-wrap: wrap; }

  /* ----- icon button + "border travels around the ring" hover effect -----
     Self-contained on purpose — delete this block (and swap
     .icon-btn:hover styles back to a plain highlight) if the
     moving-outline look doesn't end up working for you. */
  .icon-btn{
    position: relative;
    width: 46px; height:46px; border-radius:50%;
    background: var(--glass); border: 1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    color: var(--text); text-decoration:none;
  }
  .icon-btn svg{ width:19px; height:19px; position:relative; z-index:1; }
  .icon-btn::before{
    content:"";
    position:absolute; inset:-2px; border-radius:50%; padding:2px;
    background: conic-gradient(from 0deg, transparent 0deg, var(--cyan) 40deg, transparent 90deg);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity .2s ease;
  }
  .icon-btn:hover::before{ opacity:1; animation: ring-travel 1.3s linear infinite; }
  @keyframes ring-travel{ to{ transform: rotate(360deg); } }
  /* ----- end moving-outline effect ----- */

  .icon-btn.add-btn{ border-style: dashed; color: var(--text-soft); }

  footer{ padding: 30px 0 50px; text-align:center; color: var(--text-soft); font-size: 12.5px; position:relative; z-index:1; }
</style>
</head>
<body>

<canvas id="fx"></canvas>

<div class="wrap">
  <div class="topbar">
    <div class="brand">
      <div class="atom">
        <svg viewBox="0 0 34 34" fill="none">
          <circle cx="17" cy="17" r="3" fill="#22D3EE"/>
          <g class="orbit">
            <ellipse cx="17" cy="17" rx="15" ry="6" stroke="#3B82F6" stroke-width="1.4"/>
            <circle cx="32" cy="17" r="2" fill="#3B82F6"/>
          </g>
          <g class="orbit o2" style="transform: rotate(60deg)">
            <ellipse cx="17" cy="17" rx="15" ry="6" stroke="#22D3EE" stroke-width="1.4" transform="rotate(60 17 17)"/>
            <circle cx="26.5" cy="4.5" r="2" fill="#22D3EE"/>
          </g>
        </svg>
      </div>
      <div>
        <div class="brand-name">Quanta</div>
        <span class="brand-tag">// quantum mechanics, one subject at a time</span>
      </div>
    </div>
    <div class="top-right">
      <div class="chip credits">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5c0-1.5 1.3-2.5 3-2.5s3 1 3 2.5-1.3 2-3 2.5-3 1-3 2.5 1.3 2.5 3 2.5 3-1 3-2.5"/></svg>
        <span id="creditsDisplay">120</span> credits
      </div>
      <div class="chip streak">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c1 4-3 5-3 9a3 3 0 0 0 6 0c0-1 0-2-1-3 2 1 3 3 3 5a5 5 0 0 1-10 0c0-5 3-6 5-11Z"/></svg>
        <span id="streakDisplay">4</span> day streak
      </div>
      <button class="profile-btn" id="profileOpenBtn" aria-label="Open profile">UN</button>
    </div>
  </div>

  <header class="hero">
    <span class="eyebrow">// one subject, done properly</span>
    <h1>Quantum Mechanics, taught by an AI tutor.</h1>
    <p>Chat through the concepts, quiz yourself, revise from summaries, and watch it add up — literally, in credits.</p>
  </header>

  <main class="bento">
    <button class="box box--tutor" data-modal="tutorModal">
      <div>
        <div class="box-icon" style="--icon-bg: rgba(59,130,246,.14); --icon-color: #5B9CFF;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        </div>
        <h3>AI Tutor</h3>
        <div class="desc">Ask anything about quantum mechanics — superposition, entanglement, the maths, all of it.</div>
        <div class="mini-log">
          <div class="mini-msg s">why does observation collapse the wavefunction?</div>
          <div class="mini-msg t">tutor is thinking…</div>
        </div>
      </div>
      <div class="foot"><span class="badge">chat · always on</span><span class="arrow">→</span></div>
    </button>

    <button class="box" data-modal="quizModal">
      <div>
        <div class="box-icon" style="--icon-bg: rgba(34,211,238,.14); --icon-color: #22D3EE;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <h3>Quizzes</h3>
        <div class="desc">Test yourself topic by topic. Earn 10–30 credits depending on difficulty.</div>
      </div>
      <div class="foot"><span class="badge" id="quizBadge">2/6 done</span><span class="arrow" style="color:var(--cyan)">→</span></div>
    </button>

    <button class="box" data-modal="summaryModal">
      <div>
        <div class="box-icon" style="--icon-bg: rgba(255,200,69,.12); --icon-color: #FFC845;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
        </div>
        <h3>Summaries</h3>
        <div class="desc">Quick chapter recaps to revise from before an exam.</div>
      </div>
      <div class="foot"><span class="badge" id="summaryBadge">3/5 done</span><span class="arrow" style="color:var(--gold)">→</span></div>
    </button>

