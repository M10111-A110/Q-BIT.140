<script>
  // ---------------------------------------------------------------
  // Background particle field — quantum-probability-cloud vibe.
  // Purely decorative; safe to delete if your teammates' build
  // doesn't want it.
  // ---------------------------------------------------------------
  (function(){
    const canvas = document.getElementById('fx');
    const ctx = canvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w, h, particles;

    function resize(){
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    function initParticles(){
      const count = Math.min(70, Math.floor((w*h)/22000));
      particles = Array.from({length: count}, () => ({
        x: Math.random()*w,
        y: Math.random()*h,
        r: Math.random()*1.6 + 0.4,
        vx: (Math.random()-0.5)*0.15,
        vy: (Math.random()-0.5)*0.15,
        hue: Math.random() > 0.5 ? '59,130,246' : '34,211,238',
        a: Math.random()*0.5 + 0.15
      }));
    }
    function draw(){
      ctx.clearRect(0,0,w,h);
      particles.forEach(p => {
        if(!reduceMotion){
          p.x += p.vx; p.y += p.vy;
          if(p.x < 0) p.x = w; if(p.x > w) p.x = 0;
          if(p.y < 0) p.y = h; if(p.y > h) p.y = 0;
        }
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
        ctx.fillStyle = `rgba(${p.hue},${p.a})`;
        ctx.fill();
      });
      if(!reduceMotion) requestAnimationFrame(draw);
    }
    resize();
    initParticles();
    draw();
    window.addEventListener('resize', () => { resize(); initParticles(); if(reduceMotion) draw(); });
  })();

  // ---------------------------------------------------------------
  // Cursor-follow glow on box hover
  // ---------------------------------------------------------------
  document.querySelectorAll('.box').forEach(box => {
    box.addEventListener('mousemove', e => {
      const rect = box.getBoundingClientRect();
      box.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      box.style.setProperty('--my', `${e.clientY - rect.top}px`);
    });
  });

  // ---------------------------------------------------------------
  // App state — in-memory demo data so the interactions are visible.
  // Front end + back end are being built separately; treat this as
  // the design/interaction reference, not the production code.
  // ---------------------------------------------------------------
  const state = {
    credits: 120,
    streak: 4,
    quizzes: [
      { title: "Fundamentals", difficulty: "easy", credits: 10, done: true },
      { title: "Schrödinger Equation", difficulty: "medium", credits: 20, done: true },
      { title: "Superposition", difficulty: "easy", credits: 10, done: false },
      { title: "Quantum Entanglement", difficulty: "medium", credits: 20, done: false },
      { title: "Heisenberg Uncertainty Principle", difficulty: "hard", credits: 30, done: false },
      { title: "Quantum Tunneling", difficulty: "hard", credits: 30, done: false },
    ],
    summaries: [
      { title: "Fundamentals — recap", difficulty: "easy", credits: 10, done: true },
      { title: "Schrödinger Equation — recap", difficulty: "medium", credits: 20, done: true },
      { title: "Superposition — recap", difficulty: "easy", credits: 10, done: true },
      { title: "Entanglement — recap", difficulty: "medium", credits: 20, done: false },
      { title: "Uncertainty Principle — recap", difficulty: "hard", credits: 30, done: false },
    ],
    lectures: [
      { title: "Intro to Quantum States", difficulty: "easy", credits: 10, done: true },
      { title: "Visualizing Superposition", difficulty: "medium", credits: 20, done: false },
      { title: "Entanglement, Explained Visually", difficulty: "medium", credits: 20, done: false },
      { title: "Inside the Uncertainty Principle", difficulty: "hard", credits: 30, done: false },
    ],
    topics: [
      { name: "Fundamentals", progress: 90 },
      { name: "Schrödinger Equation", progress: 65 },
      { name: "Superposition", progress: 40 },
      { name: "Entanglement", progress: 20 },
      { name: "Uncertainty Principle", progress: 10 },
    ]
  };

  function diffLabel(d){ return d.charAt(0).toUpperCase() + d.slice(1); }

  function renderTopBar(){
    document.getElementById('creditsDisplay').textContent = state.credits;
    document.getElementById('streakDisplay').textContent = state.streak;
  }

  function renderBadges(){
    document.getElementById('quizBadge').textContent =
      `${state.quizzes.filter(q=>q.done).length}/${state.quizzes.length} done`;
    document.getElementById('summaryBadge').textContent =
      `${state.summaries.filter(s=>s.done).length}/${state.summaries.length} done`;
    document.getElementById('lectureBadge').textContent =
      `${state.lectures.filter(l=>l.done).length}/${state.lectures.length} done`;
  }

  function renderList(containerId, items, verb){
    const el = document.getElementById(containerId);
    el.innerHTML = '';
    items.forEach((item, i) => {
      const row = document.createElement('div');
      row.className = 'item-row';
      row.innerHTML = `
        <div class="item-info">
          <h4>${item.title}</h4>
          <div class="tags">
            <span class="difficulty ${item.difficulty}">${diffLabel(item.difficulty)}</span>
            <span class="credit-tag">+${item.credits} credits</span>
          </div>
        </div>
        <button class="action-btn ${item.done ? 'done' : ''}" ${item.done ? 'disabled' : ''} data-index="${i}">
          ${item.done ? '✓ Done' : verb}
        </button>
      `;
      el.appendChild(row);
    });
    el.querySelectorAll('button[data-index]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = +btn.dataset.index;
        const item = items[idx];
        if(item.done) return;
        item.done = true;
        state.credits += item.credits;
        renderTopBar();
        renderBadges();
        renderTrackRecord();
        renderList(containerId, items, verb);
      });
    });
  }

  function renderTrackRecord(){
    document.getElementById('trCredits').textContent = state.credits;
    document.getElementById('trStreak').textContent = state.streak;
    const completed = state.quizzes.filter(q=>q.done).length
      + state.summaries.filter(s=>s.done).length
      + state.lectures.filter(l=>l.done).length;
    document.getElementById('trCompleted').textContent = completed;

    const bars = document.getElementById('topicBars');
    bars.innerHTML = '';
    state.topics.forEach(t => {
      const div = document.createElement('div');
      div.className = 'topic-bar';
      div.innerHTML = `
        <div class="tb-head"><span>${t.name}</span><span>${t.progress}%</span></div>
        <div class="tb-track"><div class="tb-fill" style="width:${t.progress}%"></div></div>
      `;
      bars.appendChild(div);
    });
  }

  // ---------------------------------------------------------------
  // Modal open/close
  // ---------------------------------------------------------------
  document.querySelectorAll('[data-modal]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      document.getElementById(trigger.dataset.modal).classList.add('open');
    });
  });
  document.getElementById('profileOpenBtn').addEventListener('click', () => {
    document.getElementById('profileModal').classList.add('open');
    showProfileView('menu');
  });
  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => btn.closest('.overlay').classList.remove('open'));
  });
  document.querySelectorAll('.overlay').forEach(ov => {
    ov.addEventListener('click', e => { if(e.target === ov) ov.classList.remove('open'); });
  });
  document.addEventListener('keydown', e => {
    if(e.key === 'Escape') document.querySelectorAll('.overlay.open').forEach(ov => ov.classList.remove('open'));
  });

  // ---------------------------------------------------------------
  // Profile modal — menu / edit / settings sub-views
  // ---------------------------------------------------------------
  const profileTitles = { menu: 'Profile', edit: 'Edit Profile', settings: 'Settings' };
  function showProfileView(view){
    document.querySelectorAll('.profile-view').forEach(v => v.classList.remove('active'));
    document.getElementById(`profileView-${view}`).classList.add('active');
    document.getElementById('profileModalTitle').textContent = profileTitles[view];
  }
  document.querySelectorAll('.menu-item[data-view]').forEach(btn => {
    btn.addEventListener('click', () => showProfileView(btn.dataset.view));
  });
  document.querySelectorAll('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => showProfileView('menu'));
  });

  // keep name/studying text in sync with the edit fields
  document.getElementById('nameInput').addEventListener('input', e => {
    document.getElementById('profileNameDisplay').textContent = e.target.value || 'User Name';
  });
  document.getElementById('studyingInput').addEventListener('input', e => {
    document.getElementById('profileStudyingDisplay').textContent = e.target.value;
  });

  // dark mode toggle
  const darkToggle = document.getElementById('darkModeToggle');
  document.getElementById('darkModeToggleRow').addEventListener('click', e => {
    if(e.target.closest('.toggle') === null && e.currentTarget !== e.target) {
      // still allow clicking anywhere on the row, fall through
    }
    const isOn = darkToggle.classList.toggle('on');
    document.body.classList.toggle('light-mode', !isOn);
  });

  // log out — placeholder only; wire this to real auth later
  document.getElementById('logoutBtn').addEventListener('click', () => {
    document.getElementById('profileModal').classList.remove('open');
    // TODO: replace with real sign-out logic once auth is connected
  });

  // editable avatar
  const avatarInput = document.getElementById('avatarInput');
  const profileAvatar = document.getElementById('profileAvatar');
  const profileOpenBtn = document.getElementById('profileOpenBtn');
  avatarInput.addEventListener('change', () => {
    const file = avatarInput.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      const url = `url(${e.target.result})`;
      profileAvatar.style.backgroundImage = url;
      profileAvatar.textContent = '';
      profileOpenBtn.style.backgroundImage = url;
      profileOpenBtn.textContent = '';
    };
    reader.readAsDataURL(file);
  });

  // add-a-link button (Discord-style "add connection")
  document.getElementById('addLinkBtn').addEventListener('click', () => {
    const url = prompt('Paste a profile URL (GitHub, X, Discord, portfolio, etc.):');
    if(!url) return;
    const a = document.createElement('a');
    a.className = 'icon-btn';
    a.href = url;
    a.target = '_blank';
    a.rel = 'noopener';
    a.title = url;
    a.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 4 6 4 9s-1.5 6.3-4 9c-2.5-2.7-4-6-4-9s1.5-6.3 4-9z"/></svg>`;
    document.getElementById('addLinkBtn').before(a);
  });

  // ---------------------------------------------------------------
  // Chat — placeholder logic only, for demoing the UI.
  // The real tutor backend is being built separately.
  // ---------------------------------------------------------------
  async function getTutorReply(message){
    await new Promise(r => setTimeout(r, 500));
    return `(placeholder reply) Once the tutor is connected, I'll answer: "${message}"`;
  }

  const chatLog = document.getElementById('chatLog');
  function addChatMsg(who, text){
    const div = document.createElement('div');
    div.className = `chat-msg ${who}`;
    div.textContent = text;
    chatLog.appendChild(div);
    chatLog.scrollTop = chatLog.scrollHeight;
  }
  async function handleChatSend(){
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if(!text) return;
    addChatMsg('student', text);
    input.value = '';
    const reply = await getTutorReply(text);
    addChatMsg('tutor', reply);
  }
  document.getElementById('chatSend').addEventListener('click', handleChatSend);
  document.getElementById('chatInput').addEventListener('keydown', e => {
    if(e.key === 'Enter') handleChatSend();
  });

  // ---------------------------------------------------------------
  // Init
  // ---------------------------------------------------------------
  renderTopBar();
  renderBadges();
  renderList('quizList', state.quizzes, 'Start Quiz');
  renderList('summaryList', state.summaries, 'Mark as Read');
  renderList('lectureList', state.lectures, 'Watch');
  renderTrackRecord();
</script>

