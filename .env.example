# ============================================================
# Q-BIT.140 — Environment Configuration Example
# ============================================================
# Copy this file to .env for local development overrides.
# NEVER commit real credentials, API keys, or private tokens.

# Optional Database Backend (Defaults to in-memory/local if unset)
SUPABASE_URL=
SUPABASE_KEY=

# Optional AI Guidance LLM Provider (Defaults to MockLLMProvider if unset)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Server Configuration
HOST=127.0.0.1
PORT=8000
